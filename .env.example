# Copy to .env (repo root). Everything is optional — the app runs without any of it.

# Enables Claude personalisation. Without it, the built-in planning engine is used.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Set to 1 to force the built-in engine even when a key is present (offline demos).
# AI_DISABLED=1

# API port (Vite dev server proxies /api to it)
PORT=4000

# Signing secret for session tokens. If unset, a random one is generated and kept in server/data/.jwt-secret
# JWT_SECRET=

# SQLite file location (default: server/data/destiny.db)
# DB_FILE=

# Comma-separated allowed origins if the client is hosted elsewhere
# CLIENT_ORIGIN=https://your-frontend.example
